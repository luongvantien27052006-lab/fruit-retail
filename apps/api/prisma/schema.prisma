// Schema Prisma (ADR-003). Bảng được thêm theo nhóm migration M02… ở các CP sau (ERD §4).
// Schema, role, extension, raise_immutable() tạo bởi infra/sql/000_bootstrap.sql trước Prisma (ADR-017).
// Migration: prisma/migrations/NNNN_<tên>/migration.sql = DDL Prisma sinh + SQL tay (CHECK, trigger, GRANT, RLS,
// seed tham chiếu); áp bằng bộ chạy SQL của dự án, không dùng `prisma migrate deploy` (ADR-020).
// Quy ước: id UUID v7 sinh ở ứng dụng (không default DB — ADR-017); tiền BIGINT; thời gian timestamptz.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core", "reporting", "reporting_private", "audit", "integration"]
}

// ───────────────────────────── Enum (schema core) ─────────────────────────────

enum UserType {
  MASTER
  VIEWER
  STAFF
  CUSTOMER

  @@schema("core")
}

enum UserStatus {
  ACTIVE
  LOCKED // khóa bởi Master (khác khóa tạm `locked_until` do nhập sai — SEC5)
  DISABLED

  @@schema("core")
}

enum Role {
  MASTER_ADMIN
  VIEW_ONLY_ADMIN
  STORE_MANAGER
  CASHIER
  PICKER
  WAREHOUSE_STAFF
  SHIPPER
  CUSTOMER

  @@schema("core")
}

enum ScopeType {
  ALL
  STORE
  WAREHOUSE

  @@schema("core")
}

enum StoreStatus {
  ACTIVE
  INACTIVE

  @@schema("core")
}

enum StorePosStatus {
  OPEN
  CLOSED

  @@schema("core")
}

enum StoreAppStatus {
  ONLINE
  PAUSED

  @@schema("core")
}

enum LocationType {
  STORAGE // kho chung
  COLD_ROOM // kho lạnh
  SHELF // kệ
  CHILLER // tủ mát
  RIPENING // khu chín
  IN_TRANSIT // đang vận chuyển (một vị trí mỗi kho/cửa hàng)

  @@schema("core")
}

/// Kiểu bán §4.2
enum SaleUnitType {
  WEIGHT
  PIECE_BY_WEIGHT
  PIECE_FIXED
  PACK_FIXED
  PACK_VARIABLE
  BUNDLE
  SERVICE

  @@schema("core")
}

/// Nhóm đơn vị §21.3.1 (chỉ để hiển thị/lọc; quy đổi nằm ở sku_units)
enum UnitKind {
  WEIGHT
  COUNT

  @@schema("core")
}

enum PriceScope {
  GLOBAL
  STORE

  @@schema("core")
}

/// giá nào đổi: giá/kg, giá/đơn vị của SKU, hoặc giá của một đơn vị bán (sku_units)
enum PriceField {
  PER_KG
  PER_UNIT
  SKU_UNIT

  @@schema("core")
}

/// §21.3.8
enum BarcodeRuleType {
  WEIGHT
  PRICE
  PRODUCT
  BATCH
  ORDER
  STAFF

  @@schema("core")
}

enum ImportType {
  CATALOG
  SUPPLIER

  @@schema("core")
}

enum ImportDuplicateMode {
  SKIP
  UPDATE
  STOP

  @@schema("core")
}

enum ImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  @@schema("core")
}

/// Phụ lục D
enum ReasonGroup {
  SPOILAGE
  POS_LINE_DELETE
  APP_ORDER_CANCEL
  DELIVERY_FAILED
  STOCKTAKE_VARIANCE
  MANUAL_WEIGHT

  @@schema("core")
}

/// §4.5
enum SupplierType {
  FARM // vườn
  COOPERATIVE // HTX
  WHOLESALER // đầu mối
  IMPORTER // nhà nhập khẩu
  OTHER

  @@schema("core")
}

enum PosDeviceStatus {
  PENDING
  ACTIVE
  REVOKED

  @@schema("core")
}

enum AuthChallengeKind {
  MFA // mfa_challenge sau /auth/login (5 phút, 1 lần — ADR-012)
  DEVICE_NONCE // nonce thiết bị POS ký khi /auth/pin, /auth/refresh

  @@schema("core")
}

enum ApprovalAction {
  LINE_DELETE
  /// không dùng nữa (NC-21: bỏ giảm giá tay) — CHECK approval_limits_no_line_discount chặn
  LINE_DISCOUNT
  SALE_VOID
  REFUND
  SPOILAGE_APPROVE
  STOCKTAKE_ADJUST
  MANUAL_WEIGHT
  NO_SALE_OPEN
  MARKDOWN

  @@schema("core")
}

enum FileStatus {
  PENDING
  READY
  REJECTED

  @@schema("core")
}

// ───────────────────────────── Tổ chức (M03 — CP04 mở rộng §4.6) ─────────────────────────────

model Store {
  id                 String               @id @db.Uuid
  code               String               @unique
  name               String
  address            String?
  status             StoreStatus          @default(ACTIVE)
  /// tọa độ WGS84 (đi cặp, CHECK phạm vi) — vùng giao dùng PostGIS ở M13
  lat                Float?
  lng                Float?
  /// giờ mở cửa theo thứ: {"mon":[["07:00","21:00"]], …} (API kiểm cấu trúc; DB chỉ kiểm là object)
  openingHours       Json?                @map("opening_hours")
  /// bán tại quầy (§4.6)
  posStatus          StorePosStatus       @default(CLOSED) @map("pos_status")
  /// nhận đơn app (§4.6) — mặc định tạm dừng tới khi Master bật
  appStatus          StoreAppStatus       @default(PAUSED) @map("app_status")
  appCapacityPerHour Int?                 @map("app_capacity_per_hour")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(6)
  registers          Register[]
  posDevices         PosDevice[]
  enrollmentCodes    PosEnrollmentCode[]
  viewerScope        ViewerProfileScope[]
  locations          Location[]
  storePrices        StorePrice[]
  priceChanges       PriceChangeLog[]
  defaultLocations   SkuDefaultLocation[]

  @@map("stores")
  @@schema("core")
}

model Warehouse {
  id         String     @id @db.Uuid
  code       String     @unique
  name       String
  address    String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(6)
  locations  Location[]

  @@map("warehouses")
  @@schema("core")
}

model Register {
  id         String      @id @db.Uuid
  storeId    String      @map("store_id") @db.Uuid
  code       String
  name       String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime?   @map("archived_at") @db.Timestamptz(6)
  store      Store       @relation(fields: [storeId], references: [id])
  posDevices PosDevice[]

  @@unique([storeId, code])
  @@unique([id, storeId])
  @@map("registers")
  @@schema("core")
}

/// Vị trí trong kho / cửa hàng (§4.6); thuộc đúng MỘT nơi (CHECK); `sort` = thứ tự lộ trình nhặt hàng (§21.3.19)
model Location {
  id          String               @id @db.Uuid
  storeId     String?              @map("store_id") @db.Uuid
  warehouseId String?              @map("warehouse_id") @db.Uuid
  type        LocationType
  code        String
  name        String
  sort        Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt  DateTime?            @map("archived_at") @db.Timestamptz(6)
  store       Store?               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  warehouse   Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  skuDefaults SkuDefaultLocation[]

  @@unique([storeId, code])
  @@unique([warehouseId, code])
  @@unique([id, storeId])
  @@map("locations")
  @@schema("core")
}

// ───────────────────────────── Danh mục (M04, CP04) ─────────────────────────────

/// Đơn vị tính §21.3.1 (mã cố định, seed); quy đổi theo từng SKU ở sku_units
model Unit {
  code       String    @id
  name       String
  kind       UnitKind
  /// đơn vị khối lượng chuẩn: số gram cố định (KG = 1000) — sku_units dùng đơn vị này phải có factor_g đúng bằng
  fixedG     Int?      @map("fixed_g")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  skuUnits   SkuUnit[]

  @@map("units")
  @@schema("core")
}

/// Cây danh mục (§4.1); không xóa — lưu trữ bằng archived_at
model Category {
  id         String     @id @db.Uuid
  parentId   String?    @map("parent_id") @db.Uuid
  name       String
  sort       Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(6)
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  products   Product[]

  @@index([parentId])
  @@map("categories")
  @@schema("core")
}

model Product {
  id          String    @id @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String
  description String?
  origin      String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categoryId], references: [id])
  skus        Sku[]

  @@index([categoryId])
  @@map("products")
  @@schema("core")
}

/// SKU §4.3. Kiểu bán bất biến (không GRANT UPDATE) — đổi kiểu bán = SKU mới. Tiền BIGINT đồng; gram INTEGER.
/// Mã vạch nằm ở sku_units (một chỗ, unique toàn cục). Giá lẻ chung ở đây; theo cửa hàng ở store_prices.
model Sku {
  id                      String               @id @db.Uuid
  productId               String               @map("product_id") @db.Uuid
  skuCode                 String               @unique @map("sku_code")
  name                    String
  saleUnitType            SaleUnitType         @map("sale_unit_type")
  stdWeightG              Int?                 @map("std_weight_g")
  weightMinG              Int?                 @map("weight_min_g")
  weightMaxG              Int?                 @map("weight_max_g")
  tareG                   Int?                 @map("tare_g")
  retailPricePerKg        BigInt?              @map("retail_price_per_kg")
  retailPricePerUnit      BigInt?              @map("retail_price_per_unit")
  /// PLU 5 số trên cân in tem; unique trong các SKU chưa lưu trữ
  scalePlu                String?              @map("scale_plu")
  /// "bán qua cân" — chỉ các SKU này vào file PLU (§21.3.17)
  soldByScale             Boolean              @default(false) @map("sold_by_scale")
  shelfLifeDays           Int?                 @map("shelf_life_days")
  storageNote             String?              @map("storage_note")
  hasRipeness             Boolean              @default(false) @map("has_ripeness")
  /// định mức hao hụt/tuần, phần vạn (ADR-016: *_pct → *_bps)
  shrinkNormBpsWeek       Int?                 @map("shrink_norm_bps_week")
  isHighValue             Boolean              @default(false) @map("is_high_value")
  coldRequired            Boolean              @default(false) @map("cold_required")
  /// §21.3.7 — số ngày trước hạn: cảnh báo / ngừng bán trên app
  alertDaysBeforeExpiry   Int?                 @map("alert_days_before_expiry")
  stopAppDaysBeforeExpiry Int?                 @map("stop_app_days_before_expiry")
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt              DateTime?            @map("archived_at") @db.Timestamptz(6)
  version                 Int                  @default(0)
  product                 Product              @relation(fields: [productId], references: [id])
  units                   SkuUnit[]
  storePrices             StorePrice[]
  priceChanges            PriceChangeLog[]
  defaultLocations        SkuDefaultLocation[]
  suppliers               SupplierSku[]

  @@index([productId])
  @@map("skus")
  @@schema("core")
}

/// Đơn vị bán/mua dùng chung tồn (§21.3.1). Đúng một cách quy đổi: factor_g (tồn gram) | factor_units (tồn đếm) |
/// is_variable (thùng/sọt danh nghĩa — cân thực khi nhận, chỉ để mua). Khớp kiểu bán của SKU kiểm bằng trigger.
model SkuUnit {
  id           String           @id @db.Uuid
  skuId        String           @map("sku_id") @db.Uuid
  unitCode     String           @map("unit_code")
  /// nhãn hiển thị, vd. "Hộp 500 g", "Thùng ~5 kg"
  name         String
  factorG      Int?             @map("factor_g")
  factorUnits  Int?             @map("factor_units")
  isVariable   Boolean          @default(false) @map("is_variable")
  forSale      Boolean          @default(false) @map("for_sale")
  forPurchase  Boolean          @default(false) @map("for_purchase")
  barcode      String?
  pricePerUnit BigInt?          @map("price_per_unit")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz(6)
  sku          Sku              @relation(fields: [skuId], references: [id])
  unit         Unit             @relation(fields: [unitCode], references: [code])
  priceChanges PriceChangeLog[]

  /// đích FK composite (sku_unit_id, sku_id) của các dòng bán/mua (ERD §6.1)
  @@unique([id, skuId])
  @@index([skuId])
  @@map("sku_units")
  @@schema("core")
}

/// Giá lẻ riêng theo cửa hàng (§4.4); không có dòng ⇒ dùng giá chung của SKU
model StorePrice {
  storeId            String   @map("store_id") @db.Uuid
  skuId              String   @map("sku_id") @db.Uuid
  retailPricePerKg   BigInt?  @map("retail_price_per_kg")
  retailPricePerUnit BigInt?  @map("retail_price_per_unit")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy          String   @map("updated_by") @db.Uuid
  store              Store    @relation(fields: [storeId], references: [id])
  sku                Sku      @relation(fields: [skuId], references: [id])
  updater            User     @relation(fields: [updatedBy], references: [id])

  @@id([storeId, skuId])
  @@index([skuId])
  @@map("store_prices")
  @@schema("core")
}

/// Lịch sử giá (§4.4) — CHỈ THÊM (trigger raise_immutable); changed_at do server đặt. Là nguồn tra "giá hiệu lực tại
/// thời điểm" (lát 3): bản ghi mới nhất có changed_at ≤ t. old/new NULL = chưa có giá / bỏ giá riêng cửa hàng.
model PriceChangeLog {
  id        String     @id @db.Uuid
  skuId     String     @map("sku_id") @db.Uuid
  skuUnitId String?    @map("sku_unit_id") @db.Uuid
  storeId   String?    @map("store_id") @db.Uuid
  scope     PriceScope
  field     PriceField
  oldValue  BigInt?    @map("old_value")
  newValue  BigInt?    @map("new_value")
  reason    String
  changedBy String     @map("changed_by") @db.Uuid
  changedAt DateTime   @default(now()) @map("changed_at") @db.Timestamptz(6)
  sku       Sku        @relation(fields: [skuId], references: [id])
  skuUnit   SkuUnit?   @relation(fields: [skuUnitId, skuId], references: [id, skuId], onDelete: Restrict)
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  changer   User       @relation(fields: [changedBy], references: [id])

  @@index([skuId, changedAt])
  @@index([storeId, skuId, changedAt])
  @@index([skuUnitId, skuId])
  @@index([changedBy])
  @@map("price_change_logs")
  @@schema("core")
}

/// Vị trí mặc định của SKU ở cửa hàng (§21.3.19); vị trí phải thuộc đúng cửa hàng (FK composite)
model SkuDefaultLocation {
  storeId    String   @map("store_id") @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  store      Store    @relation(fields: [storeId], references: [id])
  sku        Sku      @relation(fields: [skuId], references: [id])
  location   Location @relation(fields: [locationId, storeId], references: [id, storeId])

  @@id([storeId, skuId])
  @@index([skuId])
  @@index([locationId, storeId])
  @@map("sku_default_locations")
  @@schema("core")
}

/// Quy tắc mã vạch (§21.3.8, §6.5) — Master cấu hình, POS tải về; thử theo priority tăng dần
model BarcodeRule {
  id            String          @id @db.Uuid
  code          String          @unique
  name          String
  priority      Int             @unique
  type          BarcodeRuleType
  /// vd. `20{PLU:5}{W:5}{C}`
  pattern       String
  /// đơn vị phần nhúng: 1 (gram / đồng), 10 (10 g), 100 (100 đồng)
  valueScale    Int             @default(1) @map("value_scale")
  ean13Checksum Boolean         @default(true) @map("ean13_checksum")
  enabled       Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("barcode_rules")
  @@schema("core")
}

/// Lượt nhập Excel (§21.3.17) — file qua files (ADR-014); dry_run chỉ kiểm, không ghi danh mục. Lát 5 dùng.
model ImportJob {
  id              String              @id @db.Uuid
  type            ImportType
  fileId          String              @map("file_id") @db.Uuid
  modeOnDuplicate ImportDuplicateMode @map("mode_on_duplicate")
  dryRun          Boolean             @map("dry_run")
  status          ImportStatus        @default(PENDING)
  totalRows       Int?                @map("total_rows")
  okRows          Int?                @map("ok_rows")
  skippedRows     Int?                @map("skipped_rows")
  errorRows       Int?                @map("error_rows")
  /// lỗi/bỏ qua theo dòng (không chứa tiền tính toán — FR-INV-01 áp cho chứng từ)
  report          Json?
  error           String?
  createdBy       String              @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt       DateTime?           @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?           @map("finished_at") @db.Timestamptz(6)
  file            File                @relation(fields: [fileId], references: [id])
  creator         User                @relation(fields: [createdBy], references: [id])

  @@index([createdBy, createdAt])
  @@index([fileId])
  @@map("import_jobs")
  @@schema("core")
}

/// Mã lý do (Phụ lục D) — seed; Master thêm/lưu trữ
model ReasonCode {
  group        ReasonGroup
  code         String
  name         String
  requiresNote Boolean     @default(false) @map("requires_note")
  sort         Int         @default(0)
  archivedAt   DateTime?   @map("archived_at") @db.Timestamptz(6)

  @@id([group, code])
  @@map("reason_codes")
  @@schema("core")
}

/// Loại thùng/sọt với bì chuẩn (§19.7) — dùng khi nhận hàng (CP05)
model ContainerType {
  id         String    @id @db.Uuid
  code       String    @unique
  name       String
  tareG      Int       @map("tare_g")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@map("container_types")
  @@schema("core")
}

/// Thương hiệu (§18.5) — đúng một dòng (id = 1)
model BrandSettings {
  id              Int      @id @db.SmallInt
  brandName       String   @map("brand_name")
  hotline         String?
  displayAddress  String?  @map("display_address")
  receiptFooter   String?  @map("receipt_footer")
  primaryColor    String?  @map("primary_color")
  privacyUrl      String?  @map("privacy_url")
  logoMonoFileId  String?  @map("logo_mono_file_id") @db.Uuid
  logoColorFileId String?  @map("logo_color_file_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?  @map("updated_by") @db.Uuid
  logoMono        File?    @relation("BrandLogoMono", fields: [logoMonoFileId], references: [id], onDelete: Restrict)
  logoColor       File?    @relation("BrandLogoColor", fields: [logoColorFileId], references: [id], onDelete: Restrict)
  updater         User?    @relation(fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("brand_settings")
  @@schema("core")
}

/// Danh bạ NCC cơ bản (§4.5, NC-27). SĐT và số tài khoản mã hóa (ADR-015); công nợ/nhận hàng ở CP05
model Supplier {
  id               String        @id @db.Uuid
  code             String        @unique
  name             String
  type             SupplierType
  contactName      String?       @map("contact_name")
  phoneEnc         Bytes?        @map("phone_enc")
  phoneHash        Bytes?        @map("phone_hash")
  bankName         String?       @map("bank_name")
  /// số tài khoản + chủ tài khoản, mã hóa AES-256-GCM (ADR-015 `suppliers.bank_enc`)
  bankEnc          Bytes?        @map("bank_enc")
  paymentTermsDays Int?          @map("payment_terms_days")
  note             String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?     @map("archived_at") @db.Timestamptz(6)
  skus             SupplierSku[]

  @@index([phoneHash])
  @@map("suppliers")
  @@schema("core")
}

/// SKU mà NCC cung cấp (§4.5); giá tham khảo gần nhất tính từ phiếu nhận (CP05)
model SupplierSku {
  supplierId      String   @map("supplier_id") @db.Uuid
  skuId           String   @map("sku_id") @db.Uuid
  supplierSkuCode String?  @map("supplier_sku_code")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  sku             Sku      @relation(fields: [skuId], references: [id])

  @@id([supplierId, skuId])
  @@index([skuId])
  @@map("supplier_skus")
  @@schema("core")
}

// ───────────────────────────── Người dùng & quyền (M02) ─────────────────────────────

model User {
  id                 String                    @id @db.Uuid
  type               UserType
  /// Đăng nhập Master/Viewer; luôn chữ thường (CHECK)
  email              String?                   @unique
  /// SĐT mã hóa AES-256-GCM (ADR-015); tra cứu bằng phone_hash (HMAC, E.164)
  phoneEnc           Bytes?                    @map("phone_enc")
  phoneHash          Bytes?                    @unique @map("phone_hash")
  passwordHash       String?                   @map("password_hash")
  /// mật khẩu tạm (Master tạo / CLI) — phải đổi trước khi đăng ký 2FA; chưa đổi quá 72 giờ ⇒ không đăng nhập (NC-22)
  mustChangePassword Boolean                   @default(false) @map("must_change_password")
  pinHash            String?                   @map("pin_hash")
  totpSecretEnc      Bytes?                    @map("totp_secret_enc")
  totpEnabledAt      DateTime?                 @map("totp_enabled_at") @db.Timestamptz(6)
  /// bước thời gian TOTP (30 s) đã dùng gần nhất — mã cùng bước hoặc cũ hơn bị từ chối (chống dùng lại, ADR-021)
  totpLastStep       BigInt?                   @map("totp_last_step")
  status             UserStatus                @default(ACTIVE)
  failedLoginCount   Int                       @default(0) @map("failed_login_count")
  lockedUntil        DateTime?                 @map("locked_until") @db.Timestamptz(6)
  lockCount          Int                       @default(0) @map("lock_count")
  lastLoginAt        DateTime?                 @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                       @default(0)
  staff              Staff?
  recoveryCodes      RecoveryCode[]
  roleAssignments    UserRoleAssignment[]
  permissionGrants   UserPermissionGrant[]
  sessions           Session[]
  lockouts           AuthLockout[]
  /// ADR-030 (review cổng lần 2): ngân sách lần sai theo TÀI KHOẢN trong cửa sổ 24 giờ, cộng mọi nguồn
  failWindowCount    Int                       @default(0) @map("fail_window_count")
  failWindowStart    DateTime?                 @map("fail_window_start") @db.Timestamptz(6)
  /// mốc an ninh (reset 2FA, đổi mật khẩu, đặt lại PIN, khóa/tắt, refresh bị dùng lại): chỉ phiên tạo SAU mốc này làm trình
  /// duyệt / máy thành "quen" (review cổng lần 4 T-7)
  trustEpoch         DateTime?                 @map("trust_epoch") @db.Timestamptz(6)
  viewerAssignments  ViewerProfileAssignment[]
  authChallenges     AuthChallenge[]
  enrollmentCodes    PosEnrollmentCode[]
  filesCreated       File[]
  priceChanges       PriceChangeLog[]
  storePriceUpdates  StorePrice[]
  importJobs         ImportJob[]
  brandUpdates       BrandSettings[]

  @@map("users")
  @@schema("core")
}

/// 10 mã khôi phục 2FA dùng một lần (Argon2id — ADR-012)
model RecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("recovery_codes")
  @@schema("core")
}

model Staff {
  userId    String       @id @map("user_id") @db.Uuid
  staffCode String       @unique @map("staff_code")
  fullName  String       @map("full_name")
  hiredAt   DateTime?    @map("hired_at") @db.Date
  leftAt    DateTime?    @map("left_at") @db.Date
  user      User         @relation(fields: [userId], references: [id])
  badges    StaffBadge[]

  @@map("staff")
  @@schema("core")
}

/// Thẻ nhân viên (§21.3.9) — chỉ lưu hash mã thẻ
model StaffBadge {
  id            String    @id @db.Uuid
  staffId       String    @map("staff_id") @db.Uuid
  badgeCodeHash Bytes     @unique @map("badge_code_hash")
  issuedBy      String    @map("issued_by") @db.Uuid
  issuedAt      DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  staff         Staff     @relation(fields: [staffId], references: [userId])

  @@index([staffId])
  @@map("staff_badges")
  @@schema("core")
}

/// Mã quyền §19.6/§21.8 + 5 mã NC-08 — dữ liệu tham chiếu, chỉ đổi bằng migration
model Permission {
  code             String                @id
  description      String
  addedOutsideSpec Boolean               @default(false) @map("added_outside_spec")
  roles            RolePermission[]
  grants           UserPermissionGrant[]

  @@map("permissions")
  @@schema("core")
}

/// Ánh xạ vai trò → mã quyền theo ma trận §2.2 (seed; chỉ đổi bằng migration)
model RolePermission {
  role           Role
  permissionCode String     @map("permission_code")
  permission     Permission @relation(fields: [permissionCode], references: [code])

  @@id([role, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
  @@schema("core")
}

model UserRoleAssignment {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      Role
  scopeType ScopeType @map("scope_type")
  /// store_id hoặc warehouse_id theo scope_type; NULL khi ALL (CHECK + trigger kiểm tồn tại)
  scopeId   String?   @map("scope_id") @db.Uuid
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedBy String?   @map("revoked_by") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([scopeType, scopeId])
  @@map("user_role_assignments")
  @@schema("core")
}

/// Quyền cấp riêng cho một người (vd WAREHOUSE_STAFF + purchase_price:write — §2.1)
model UserPermissionGrant {
  id             String     @id @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  permissionCode String     @map("permission_code")
  scopeType      ScopeType  @map("scope_type")
  scopeId        String?    @map("scope_id") @db.Uuid
  grantedBy      String     @map("granted_by") @db.Uuid
  grantedAt      DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedBy      String?    @map("revoked_by") @db.Uuid
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(6)
  user           User       @relation(fields: [userId], references: [id])
  permission     Permission @relation(fields: [permissionCode], references: [code])

  @@index([userId])
  @@index([permissionCode])
  @@map("user_permission_grants")
  @@schema("core")
}

/// Hạn mức duyệt §2.3. Cả hai ngưỡng NULL = không giới hạn; có cả hai = đạt MỘT trong hai là được ("≤ 10% hoặc
/// ≤ 50.000đ"). allowed=false = vai trò không được làm hành động này.
model ApprovalLimit {
  role         Role
  action       ApprovalAction
  allowed      Boolean        @default(true)
  maxAmount    BigInt?        @map("max_amount")
  /// phần trăm theo basis point (10% = 1000)
  maxPctBp     Int?           @map("max_pct_bp")
  /// ANY = đạt MỘT trong hai ngưỡng là được ("hoặc" — §2.3); ALL = phải đạt cả hai
  limitMode    String         @default("ANY") @map("limit_mode")
  sameDayOnly  Boolean        @default(false) @map("same_day_only")
  requiresPin  Boolean        @default(false) @map("requires_pin")
  requiresNote Boolean        @default(false) @map("requires_note")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?        @map("updated_by") @db.Uuid

  @@id([role, action])
  @@map("approval_limits")
  @@schema("core")
}

// ───────────────────────────── Thiết bị, phiên, thử thách ─────────────────────────────

/// Thiết bị POS (SEC3): máy tự sinh khóa Ed25519, đăng ký PENDING → kích hoạt → ACTIVE; thu hồi → REVOKED
model PosDevice {
  id           String             @id @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  registerId   String?            @map("register_id") @db.Uuid
  name         String
  platform     String
  publicKey    Bytes              @map("public_key")
  /// SHA-256 của public_key
  fingerprint  Bytes              @unique
  status       PosDeviceStatus    @default(PENDING)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  activatedBy  String?            @map("activated_by") @db.Uuid
  activatedAt  DateTime?          @map("activated_at") @db.Timestamptz(6)
  revokedBy    String?            @map("revoked_by") @db.Uuid
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?            @map("revoke_reason")
  lastSeenAt   DateTime?          @map("last_seen_at") @db.Timestamptz(6)
  store        Store              @relation(fields: [storeId], references: [id])
  /// quầy phải thuộc cùng cửa hàng (FK kép register_id + store_id)
  register     Register?          @relation(fields: [registerId, storeId], references: [id, storeId], onDelete: Restrict, onUpdate: Restrict)
  sessions     Session[]
  challenges   AuthChallenge[]
  enrollment   PosEnrollmentCode?

  @@index([storeId])
  @@index([registerId])
  @@map("pos_devices")
  @@schema("core")
}

/// Mã ghi danh thiết bị POS (ADR-022, sửa M1): Master/cửa hàng trưởng tạo cho một cửa hàng, dùng một lần, hạn ngắn.
/// Chỉ lưu SHA-256 của mã. Trigger: mốc do server đặt, đã dùng thì khóa, thiết bị dùng mã phải PENDING cùng cửa hàng.
model PosEnrollmentCode {
  id             String     @id @db.Uuid
  storeId        String     @map("store_id") @db.Uuid
  codeHash       Bytes      @unique @map("code_hash")
  createdBy      String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?  @map("used_at") @db.Timestamptz(6)
  usedByDeviceId String?    @unique @map("used_by_device_id") @db.Uuid
  store          Store      @relation(fields: [storeId], references: [id])
  creator        User       @relation(fields: [createdBy], references: [id])
  usedByDevice   PosDevice? @relation(fields: [usedByDeviceId], references: [id], onDelete: Restrict)

  @@index([storeId, expiresAt])
  @@map("pos_enrollment_codes")
  @@schema("core")
}

/// Khóa đăng nhập theo cặp (tài khoản, nguồn) — ADR-030 (sửa review cổng CP03): kẻ ẩn danh sai mật khẩu chỉ khóa
/// chính nguồn của mình (mạng IP /64, hoặc máy POS với PIN), người dùng thật ở nguồn khác vẫn vào được.
/// `source`: 'ip:<sha256(bucket) 22 ký tự>' | 'dev:<uuid thiết bị>' (không lưu IP thô).
model AuthLockout {
  userId      String    @map("user_id") @db.Uuid
  source      String
  failedCount Int       @default(0) @map("failed_count")
  lockCount   Int       @default(0) @map("lock_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, source])
  @@index([userId, lockedUntil])
  @@map("auth_lockouts")
  @@schema("core")
}

/// Một phiên = một họ refresh token (ADR-012 `family_id`); xoay vòng lưu ở refresh_tokens
model Session {
  id                String         @id @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  userType          UserType       @map("user_type")
  posDeviceId       String?        @map("pos_device_id") @db.Uuid
  /// X-Device-Id của app khách / trình duyệt admin (không phải POS)
  clientDevice      String?        @map("client_device")
  amr               String[]
  stepUpUntil       DateTime?      @map("step_up_until") @db.Timestamptz(6)
  /// lần xác thực lại sai (step-up / mật khẩu hiện tại) TRONG phiên này — đủ 5 ⇒ thu hồi phiên (ADR-030)
  reauthFailedCount Int            @default(0) @map("reauth_failed_count")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime       @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?        @map("revoke_reason")
  ipHash            Bytes?         @map("ip_hash")
  userAgent         String?        @map("user_agent")
  user              User           @relation(fields: [userId], references: [id])
  posDevice         PosDevice?     @relation(fields: [posDeviceId], references: [id])
  tokens            RefreshToken[]

  @@index([userId])
  @@index([posDeviceId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("core")
}

model RefreshToken {
  id           String        @id @db.Uuid
  sessionId    String        @map("session_id") @db.Uuid
  /// SHA-256 của refresh token 256-bit
  tokenHash    Bytes         @unique @map("token_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// đã xoay (dùng lại token đã xoay ⇒ thu hồi cả phiên — ADR-012)
  usedAt       DateTime?     @map("used_at") @db.Timestamptz(6)
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  session      Session       @relation(fields: [sessionId], references: [id])
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("TokenRotation")

  @@index([sessionId])
  @@map("refresh_tokens")
  @@schema("core")
}

model AuthChallenge {
  id          String            @id @db.Uuid
  kind        AuthChallengeKind
  userId      String?           @map("user_id") @db.Uuid
  posDeviceId String?           @map("pos_device_id") @db.Uuid
  secretHash  Bytes             @unique @map("secret_hash")
  attempts    Int               @default(0)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?         @map("used_at") @db.Timestamptz(6)
  user        User?             @relation(fields: [userId], references: [id])
  posDevice   PosDevice?        @relation(fields: [posDeviceId], references: [id])

  @@index([expiresAt])
  @@index([userId])
  @@index([posDeviceId])
  @@map("auth_challenges")
  @@schema("core")
}

/// OTP khách (SEC6): mã 6 số hạn 5 phút, tối đa 5 lần thử; giới hạn gửi theo phone_hash / device / IP
model OtpChallenge {
  id         String    @id @db.Uuid
  phoneHash  Bytes     @map("phone_hash")
  deviceId   String?   @map("device_id")
  ipHash     Bytes?    @map("ip_hash")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt])
  @@map("otp_challenges")
  @@schema("core")
}

// ───────────────────────────── Viewer (§2.5, §10.3) ─────────────────────────────

model ViewerProfile {
  id                   String                    @id @db.Uuid
  code                 String                    @unique
  name                 String
  /// true = toàn chuỗi (mọi cửa hàng, kể cả mở sau); false = theo viewer_profile_scopes
  allStores            Boolean                   @default(false) @map("all_stores")
  modules              String[]
  customerVisibility   String                    @map("customer_visibility")
  costVisibility       String                    @map("cost_visibility")
  supplierVisibility   String                    @map("supplier_visibility")
  posControlVisibility String                    @map("pos_control_visibility")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt           DateTime?                 @map("archived_at") @db.Timestamptz(6)
  assignments          ViewerProfileAssignment[]
  scopes               ViewerProfileScope[]

  @@map("viewer_profiles")
  @@schema("core")
}

model ViewerProfileAssignment {
  userId          String        @map("user_id") @db.Uuid
  viewerProfileId String        @map("viewer_profile_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id])
  viewerProfile   ViewerProfile @relation(fields: [viewerProfileId], references: [id])

  @@id([userId, viewerProfileId])
  @@index([viewerProfileId])
  @@map("viewer_profile_assignments")
  @@schema("core")
}

/// Cửa hàng của hồ sơ viewer — đọc bởi reporting.allowed_stores() (SECURITY DEFINER); viewer không có USAGE schema này
model ViewerProfileScope {
  profileId String        @map("profile_id") @db.Uuid
  storeId   String        @map("store_id") @db.Uuid
  profile   ViewerProfile @relation(fields: [profileId], references: [id])
  store     Store         @relation(fields: [storeId], references: [id])

  @@id([profileId, storeId])
  @@index([storeId])
  @@map("viewer_profile_scopes")
  @@schema("reporting_private")
}

// ───────────────────────────── File (ADR-014) ─────────────────────────────

model File {
  id              String          @id @db.Uuid
  kind            String
  mime            String
  ownerType       String?         @map("owner_type")
  ownerId         String?         @map("owner_id") @db.Uuid
  storageKey      String          @unique @map("storage_key")
  /// khóa object cuối của file READY (mỗi lần complete chép sang khóa riêng — ADR-025)
  finalKey        String?         @map("final_key")
  declaredBytes   Int             @map("declared_bytes")
  declaredSha256  Bytes           @map("declared_sha256")
  /// do server tính lại sau khi tải object (ADR-014)
  bytes           Int?
  sha256          Bytes?
  status          FileStatus      @default(PENDING)
  rejectReason    String?         @map("reject_reason")
  duplicateOfId   String?         @map("duplicate_of_id") @db.Uuid
  captureSource   String?         @map("capture_source")
  capturedAt      DateTime?       @map("captured_at") @db.Timestamptz(6)
  deviceId        String?         @map("device_id")
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz(6)
  creator         User            @relation(fields: [createdBy], references: [id])
  duplicateOf     File?           @relation("FileDuplicate", fields: [duplicateOfId], references: [id])
  duplicates      File[]          @relation("FileDuplicate")
  importJobs      ImportJob[]
  brandLogosMono  BrandSettings[] @relation("BrandLogoMono")
  brandLogosColor BrandSettings[] @relation("BrandLogoColor")

  @@index([sha256])
  @@index([createdBy])
  @@index([duplicateOfId])
  @@index([ownerType, ownerId])
  @@map("files")
  @@schema("core")
}

// ───────────────────────────── audit (chỉ thêm — ADR-011) ─────────────────────────────

model AuditLog {
  id           String   @id @db.Uuid
  at           DateTime @default(now()) @db.Timestamptz(6)
  actorId      String?  @map("actor_id") @db.Uuid
  actorType    String?  @map("actor_type")
  role         String?
  ip           String?  @db.Inet
  deviceId     String?  @map("device_id")
  requestId    String?  @map("request_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  before       Json?
  after        Json?
  reason       String?

  @@index([resourceType, resourceId])
  @@index([actorId, at])
  @@index([at])
  @@map("logs")
  @@schema("audit")
}

model LoginLog {
  id             String   @id @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz(6)
  userId         String?  @map("user_id") @db.Uuid
  /// HMAC của email/SĐT/mã NV đã nhập (không lưu rõ)
  identifierHash Bytes?   @map("identifier_hash")
  result         String
  ip             String?  @db.Inet
  device         String?
  userAgent      String?  @map("user_agent")

  @@index([userId, at])
  @@index([at])
  @@map("login_logs")
  @@schema("audit")
}

model ExportLog {
  id         String   @id @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  userId     String   @map("user_id") @db.Uuid
  exportType String   @map("export_type")
  filters    Json
  rows       Int
  fileId     String?  @map("file_id") @db.Uuid

  @@index([userId, at])
  @@map("export_logs")
  @@schema("audit")
}

model ViewerAccess {
  id         String   @id @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)
  userId     String   @map("user_id") @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  resource   String
  snapshotId String?  @map("snapshot_id") @db.Uuid

  @@index([userId, at])
  @@map("viewer_access")
  @@schema("audit")
}

// ───────────────────────────── integration (ADR-007) ─────────────────────────────

model Outbox {
  id            String    @id @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @map("schema_version")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(6)

  @@index([publishedAt, deadAt, nextAttemptAt])
  @@map("outbox")
  @@schema("integration")
}

model ProcessedEvent {
  consumer String
  eventId  String   @map("event_id") @db.Uuid
  at       DateTime @default(now()) @db.Timestamptz(6)

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("integration")
}

/// Sổ migration của bộ chạy SQL — bảng tạo bởi infra/sql/000_bootstrap.sql (KHÔNG có trong migration Prisma); khai
/// báo ở đây chỉ để `prisma migrate diff` không coi là lệch. Không role ứng dụng nào có quyền trên bảng này.
model SqlMigration {
  file      String   @id
  sha256    String
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("sql_migrations")
  @@schema("integration")
}

/// Idempotency-Key HTTP (ADR-007): scope = principal + method + route; giữ 48 giờ
model IdempotencyKey {
  scope          String
  key            String    @db.Uuid
  requestHash    Bytes     @map("request_hash")
  status         String
  responseStatus Int?      @map("response_status")
  response       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("integration")
}
