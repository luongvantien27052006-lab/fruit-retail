# Mẫu biến môi trường (SPEC §19.4, ADR-011/012/014/015). KHÔNG điền secret thật vào file này.
# Local: cp infra/.env.example infra/.env rồi thay mọi "change-me" (≥ 12 ký tự ngẫu nhiên).

# --- PostgreSQL: mật khẩu từng role (ADR-011) ---
PG_OWNER_PASSWORD=change-me-owner-password
PG_APP_RW_PASSWORD=change-me-app-rw-password
PG_PROJECTOR_RW_PASSWORD=change-me-projector-password
PG_VIEWER_RO_PASSWORD=change-me-viewer-ro-password
PG_VIEWER_ACT_PASSWORD=change-me-viewer-act-password
PG_AUDIT_WRITER_PASSWORD=change-me-audit-writer-password
# DATABASE_URL_* dựng trong docker-compose từ các mật khẩu trên.

# --- Ứng dụng ---
TZ=Asia/Ho_Chi_Minh
BUSINESS_DAY_CUTOFF=04:00

# --- Token (ADR-012) — CP03 ---
JWT_SIGNING_KEYS=
# --- PII (ADR-015) — CP03 ---
PII_ENC_KEYS=
PII_HASH_PEPPER=

# --- Đối tác (thiếu → 503 CONFIGURATION_NOT_READY cho tác vụ mới) ---
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT_ID=
AHAMOVE_API_KEY=
AHAMOVE_BASE_URL=
AHAMOVE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER=
MAP_PROVIDER=
MAP_API_KEY=

# --- File (ADR-014) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Giám sát ---
SENTRY_DSN=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
