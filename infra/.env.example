# Mẫu biến môi trường (SPEC §19.4, ADR-011/012/014/015). KHÔNG điền secret thật vào file này.
# Local: cp infra/.env.example infra/.env rồi thay mọi "change-me" bằng chuỗi ngẫu nhiên khác nhau
# (≥ 12 ký tự ở dev, ≥ 24 ở staging/production). Bộ chạy DB từ chối giá trị còn "change-me" hoặc trùng nhau.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# --- PostgreSQL: mật khẩu từng role (ADR-011) ---
PG_OWNER_PASSWORD=change-me-owner-password
PG_APP_RW_PASSWORD=change-me-app-rw-password
PG_PROJECTOR_RW_PASSWORD=change-me-projector-password
PG_VIEWER_RO_PASSWORD=change-me-viewer-ro-password
PG_VIEWER_ACT_PASSWORD=change-me-viewer-act-password
PG_AUDIT_WRITER_PASSWORD=change-me-audit-writer-password
# DATABASE_URL_* dựng trong docker-compose từ các mật khẩu trên.

# --- Backup WAL-G (docker-compose.backup.yml) ---
# 32 byte ngẫu nhiên dạng base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALG_LIBSODIUM_KEY=change-me-base64-32-bytes

# --- Redis (requirepass) ---
REDIS_PASSWORD=change-me-redis-password

# --- Ứng dụng ---
TZ=Asia/Ho_Chi_Minh
BUSINESS_DAY_CUTOFF=04:00

# --- Token (ADR-012, ADR-021) — CP03 ---
# Danh sách kid:base64(PKCS#8 DER Ed25519), cách nhau dấu phẩy; khóa CUỐI dùng để ký, mọi khóa dùng để kiểm.
# Tạo một khóa: node -e "const{privateKey}=require('crypto').generateKeyPairSync('ed25519');console.log('k1:'+privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
# Xoay: thêm khóa mới vào CUỐI, triển khai, đợi ≥ 15 phút (hạn access token) rồi bỏ khóa cũ.
JWT_SIGNING_KEYS=
# --- PII (ADR-015) — CP03 ---
# id:base64(32 byte), id 1..65535; khóa ghi = id lớn nhất, khóa cũ giữ lại để giải mã đến khi mã hóa lại xong.
# Tạo: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
PII_ENC_KEYS=
# base64 ≥ 32 byte; KHÔNG đổi sau khi chạy thật (đổi ⇒ mọi hash tra cứu cũ mất tác dụng).
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_HASH_PEPPER=

# --- Đối tác (thiếu → 503 CONFIGURATION_NOT_READY cho tác vụ mới) ---
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT_ID=
AHAMOVE_API_KEY=
AHAMOVE_BASE_URL=
AHAMOVE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER=
MAP_PROVIDER=
MAP_API_KEY=

# --- File (ADR-014) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Giám sát ---
SENTRY_DSN=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
