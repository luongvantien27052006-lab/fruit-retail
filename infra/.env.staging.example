# Mẫu env STAGING/PRODUCTION trên VPS (copy thành infra/.env trên VPS, chmod 600, KHÔNG commit).
# Mọi mật khẩu ≥ 24 ký tự ngẫu nhiên, khác nhau: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Bản sao khóa WALG_LIBSODIUM_KEY lưu NGOÀI VPS (két mật khẩu) — mất khóa = mất backup.

# --- Domain / HTTPS ---
APP_DOMAIN=change-me.example.invalid
ACME_EMAIL=change-me@example.invalid

# --- PostgreSQL ---
PG_OWNER_PASSWORD=change-me
PG_APP_RW_PASSWORD=change-me
PG_PROJECTOR_RW_PASSWORD=change-me
PG_VIEWER_RO_PASSWORD=change-me
PG_VIEWER_ACT_PASSWORD=change-me
PG_AUDIT_WRITER_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- Backup WAL-G → S3 ở NHÀ CUNG CẤP KHÁC VPS (SPEC §3.6) ---
WALG_LIBSODIUM_KEY=change-me-base64-32-bytes
WALG_S3_PREFIX=s3://change-me-bucket/staging
WALG_AWS_ACCESS_KEY_ID=change-me
WALG_AWS_SECRET_ACCESS_KEY=change-me
WALG_AWS_ENDPOINT=https://change-me.example.invalid
WALG_AWS_REGION=auto
WALG_AWS_S3_FORCE_PATH_STYLE=true
# Cron trên VPS không dọn backup (khóa không có quyền xóa) — runbook-backup.md
BACKUP_RETAIN_FULL=0
