# Caddy local (HTTP, cổng 8080). Staging/production dùng Caddyfile có domain + HTTPS tự động + HSTS
# (Strict-Transport-Security "max-age=31536000; includeSubDomains") — CP02 phần VPS.
{
	admin off
}

:8080 {
	encode gzip
	request_body {
		max_size 10MB
	}
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
	# Không tin X-Request-Id từ client ngoài: Caddy đặt mã riêng; API kiểm định dạng (app.module.ts).
	handle /v1/* {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
	handle {
		# CSP do admin-web đặt (proxy.ts: nonce mỗi request, không 'unsafe-inline' — ADR-027). Caddy KHÔNG đặt CSP ở đây.
		reverse_proxy admin-web:3001 {
			header_up X-Request-Id {http.request.uuid}
		}
	}
}
