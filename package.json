{
  "name": "fruit-retail",
  "private": true,
  "description": "Hệ thống chuỗi bán lẻ hoa quả — monorepo (ADR-001)",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "lint": "pnpm run build:libs && pnpm -r --if-present run lint",
    "typecheck": "pnpm run build:libs && pnpm -r --if-present run typecheck",
    "test": "pnpm run build:libs && pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "check:contracts": "pnpm --filter @fruit/contracts run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:libs": "pnpm --filter @fruit/money_weight run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
