{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-retail.local/events/_envelope.json",
  "title": "Event envelope (ADR-007)",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "aggregate_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v7; khóa idempotent của consumer (processed_events)"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Mọi sự kiện chỉ đi giữa API/worker (outbox → BullMQ). KHÔNG đẩy thô ra Socket.IO; realtime theo packages/contracts/realtime/rooms.json (ADR-013)."
}
