{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-retail.local/events/auth.new_device_login.json",
  "title": "auth.new_device_login",
  "description": "Admin đăng nhập từ thiết bị mới (SEC5, ADR-012). Chi tiết hoàn thiện ở CP03.",
  "x-detail-cp": "CP03",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "auth.new_device_login"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": ["user_id", "device_id", "at"],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "x-audience": "internal:master-alert",
  "x-sensitivity": "restricted"
}
