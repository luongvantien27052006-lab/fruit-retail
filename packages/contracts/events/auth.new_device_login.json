{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-retail.local/events/auth.new_device_login.json",
  "title": "auth.new_device_login",
  "description": "Master/Viewer lần đầu qua 2FA trên một thiết bị (X-Device-Id chưa từng có phiên đã qua 2FA, hoặc không gửi X-Device-Id) — SEC5, ADR-012/021. Không chứa IP/User-Agent.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "auth.new_device_login"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": ["user_id", "session_id", "at"],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "description": "phiên mới (Master xem chi tiết thiết bị ở /admin/users/{id}/sessions)"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "x-audience": "internal:master-alert",
  "x-sensitivity": "restricted"
}
