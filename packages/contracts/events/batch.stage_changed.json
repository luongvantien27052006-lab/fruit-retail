{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-retail.local/events/batch.stage_changed.json",
  "title": "batch.stage_changed",
  "description": "Đổi độ chín (SPEC §13.3). Chi tiết hoàn thiện ở CP17.",
