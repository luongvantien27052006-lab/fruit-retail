        "batch_id",
        "from_stage",
        "to_stage"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "from_stage": {
          "type": "string"
        },
        "to_stage": {
          "type": "string"
        }
      },
      "additionalProperties": false
