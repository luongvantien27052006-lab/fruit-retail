{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-retail.local/events/device.offline.json",
  "title": "device.offline",
  "description": "Thiết bị mất kết nối (SPEC §13.3). Chi tiết hoàn thiện ở CP07.",
  "x-detail-cp": "CP07",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "device.offline"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "device_id",
        "store_id",
        "last_seen_at"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "store_id": {
          "type": "string",
          "format": "uuid"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    }
  }
}
