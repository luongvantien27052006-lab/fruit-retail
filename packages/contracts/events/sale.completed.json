{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fruit-retail.local/events/sale.completed.json",
  "title": "sale.completed",
  "description": "Hóa đơn POS chốt — báo cáo realtime, kiểm soát POS (SPEC §13.3). Chi tiết hoàn thiện ở CP07.",
  "x-detail-cp": "CP07",
  "type": "object",
  "allOf": [
    {
      "$ref": "_envelope.json"
    }
  ],
  "properties": {
    "event_type": {
      "const": "sale.completed"
    },
    "schema_version": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "sale_id",
        "store_id",
        "shift_id",
        "business_date",
        "total_amount",
        "weight_g",
        "is_offline"
      ],
      "properties": {
        "sale_id": {
          "type": "string",
          "format": "uuid"
        },
        "store_id": {
          "type": "string",
          "format": "uuid"
        },
        "shift_id": {
          "type": "string",
          "format": "uuid"
        },
        "business_date": {
          "type": "string",
          "format": "date"
        },
        "total_amount": {
          "type": "string",
          "pattern": "^-?[0-9]{1,18}$"
        },
        "weight_g": {
          "type": "integer",
          "minimum": 0
        },
        "is_offline": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "x-audience": "internal:reporting,pos-control",
  "x-sensitivity": "internal"
}
