      "actors": [
        "STORE",
        "SYSTEM",
        "COURIER"
      ],
      "note": "3PL không tìm được tài xế / hủy — gán lại",
      "effects": [
        "CANCEL_COURIER"
      ]
    },
    {
      "from": "DELIVERING",
      "to": "DELIVERED",
      "actors": [
        "SHIPPER",
        "COURIER"
      ],
      "note": "",
