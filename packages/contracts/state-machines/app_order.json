        "COLLECT_CASH_AT_PICKUP"
      ],
      "guard": "fulfillment_type = PICKUP"
    },
    {
      "from": "PACKED",
      "to": "CANCELLED",
      "actors": [
        "STORE",
        "SYSTEM",
        "MASTER"
      ],
      "note": "Quá giờ lấy (PHONE/PICKUP) hoặc Master can thiệp",
      "effects": [
        "RETURN_STOCK_OR_SPOIL",
        "RETURN_QUOTA",
        "REFUND_IF_PAID",
        "REQUIRE_REASON"
      ]
    },
