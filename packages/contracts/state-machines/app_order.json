    {
      "from": "DELIVERY_FAILED",
      "to": "CANCELLED",
      "actors": [
        "STORE",
        "MASTER"
      ],
      "note": "",
      "effects": [
        "RETURN_STOCK_OR_SPOIL",
        "REFUND_IF_PAID",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "DELIVERED",
      "to": "COMPLETED",
