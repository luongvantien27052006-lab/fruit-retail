        "RELEASE_HOLD",
        "RETURN_QUOTA",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "PICKING",
      "to": "WEIGHED",
      "actors": [
        "STORE"
      ],
      "note": "Cân từng dòng + ảnh",
      "effects": [
        "COMPUTE_ACTUAL_AMOUNT"
      ]
    },
    {
      "from": "PICKING",
      "to": "CANCELLED",
      "actors": [
        "STORE",
        "SYSTEM",
        "MASTER"
      ],
      "note": "",
      "effects": [
        "RELEASE_HOLD",
        "RETURN_QUOTA",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "WEIGHED",
      "to": "AWAITING_CONFIRM",
      "actors": [
        "SYSTEM"
      ],
      "note": "",
      "effects": [],
      "guard": "có dòng thiếu hàng"
    },
    {
      "from": "WEIGHED",
      "to": "AWAITING_PAYMENT",
      "actors": [
        "SYSTEM"
      ],
      "note": "",
      "effects": [
        "CREATE_VA"
      ],
      "guard": "payment_mode = PAY_AFTER_WEIGH và không thiếu hàng"
    },
    {
      "from": "WEIGHED",
      "to": "READY_TO_PACK",
      "actors": [
        "SYSTEM"
      ],
      "note": "",
      "effects": [],
      "guard": "payment_mode = COD hoặc (PICKUP và trả khi lấy), không thiếu hàng"
    },
    {
      "from": "WEIGHED",
      "to": "CANCELLED",
      "actors": [
        "STORE",
        "SYSTEM",
        "MASTER"
      ],
      "note": "",
      "effects": [
        "RELEASE_HOLD",
        "RETURN_QUOTA",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "AWAITING_CONFIRM",
      "to": "AWAITING_PAYMENT",
      "actors": [
        "CUSTOMER",
        "SYSTEM"
      ],
      "note": "Khách nhận phần còn lại, hoặc hết 10 phút → mặc định giao phần còn lại (§8.5)",
      "effects": [
        "ADJUST_LINES",
        "CREATE_VA"
      ],
      "guard": "payment_mode = PAY_AFTER_WEIGH"
    },
    {
      "from": "AWAITING_CONFIRM",
      "to": "READY_TO_PACK",
      "actors": [
        "CUSTOMER",
        "SYSTEM"
      ],
      "note": "Như trên",
      "effects": [
        "ADJUST_LINES"
      ],
      "guard": "payment_mode = COD hoặc trả khi lấy"
    },
    {
      "from": "AWAITING_CONFIRM",
      "to": "CANCELLED",
      "actors": [
        "CUSTOMER",
        "MASTER"
      ],
      "note": "Khách chọn hủy",
      "effects": [
        "RELEASE_HOLD",
        "RETURN_QUOTA",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "AWAITING_PAYMENT",
      "to": "READY_TO_PACK",
      "actors": [
        "SYSTEM"
      ],
      "note": "payment.succeeded",
      "effects": []
    },
    {
      "from": "AWAITING_PAYMENT",
      "to": "CANCELLED",
      "actors": [
        "SYSTEM",
        "MASTER"
      ],
      "note": "Quá 30 phút chưa trả: hàng về kệ",
      "effects": [
        "CANCEL_VA",
        "RELEASE_HOLD",
        "RETURN_QUOTA",
        "REFUND_IF_PAID",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "READY_TO_PACK",
      "to": "PACKED",
      "actors": [
        "STORE"
      ],
      "note": "Picker đóng gói (§8.3: PACKED do Picker)",
      "effects": [
        "DEDUCT_STOCK_FEFO",
        "RELEASE_HOLD",
        "PRINT_BAG_LABEL"
      ]
    },
    {
      "from": "READY_TO_PACK",
      "to": "CANCELLED",
      "actors": [
        "STORE",
        "MASTER"
      ],
      "note": "",
      "effects": [
        "RELEASE_HOLD",
        "RETURN_QUOTA",
        "REFUND_IF_PAID",
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "PACKED",
      "to": "SHIPPER_ASSIGNED",
      "actors": [
        "STORE",
        "SYSTEM"
      ],
      "note": "",
      "effects": [],
      "guard": "fulfillment_type = DELIVERY"
    },
    {
      "from": "PACKED",
      "to": "PICKED_UP",
      "actors": [
        "STORE"
      ],
      "note": "Khách lấy tại cửa hàng",
