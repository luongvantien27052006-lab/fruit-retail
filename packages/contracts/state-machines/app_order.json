        "COURIER"
      ],
      "note": "",
      "effects": [
        "REQUIRE_REASON"
      ]
    },
    {
      "from": "DELIVERY_FAILED",
      "to": "SHIPPER_ASSIGNED",
      "actors": [
        "STORE"
      ],
      "note": "Giao lại",
      "effects": []
